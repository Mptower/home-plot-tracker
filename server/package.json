{
  "name": "@hpt/server",
  "private": true,
  "version": "0.0.0",
  "description": "Express 5 + node:sqlite API and static host for The Home Plot Tracker",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "start": "node --disable-warning=ExperimentalWarning dist/src/index.js",
    "dev": "node --watch --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@hpt/shared": "*",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1"
  }
}
