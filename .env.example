# The Home Plot Tracker — server configuration.
#
# Every value here is a default that already works, so the server runs with no
# environment at all. Copy to .env and edit only what you need to change; the
# server does not read .env itself, so export these or hand them to systemd /
# the container runtime.

# Port to listen on.
PORT=8080

# Interface to bind. 0.0.0.0 accepts connections from the network, which is what
# you want behind a reverse proxy. Use 127.0.0.1 to accept only local traffic.
HOST=0.0.0.0

# Directory holding everything the server persists. Created if missing.
#
# As a Home Assistant add-on this must be /data — the persistent volume HA's
# own backups snapshot. Put the database anywhere else and the backups quietly
# contain no garden. Locally it defaults to ./data, relative to the working
# directory, which is server/ when launched by `npm start`.
DATA_DIR=/data

# Overrides the database file outright, ignoring DATA_DIR. Rarely needed; the
# tests use it to point at a temporary file. Defaults to
# $DATA_DIR/home-plot-tracker.db.
# DATABASE_PATH=

# The built client to serve, produced by `npm run build`. Relative to the
# working directory, hence the ../ back out of server/.
CLIENT_DIR=../client/dist

# Set to false to run the API on its own and let something else serve the
# client. The server logs a warning instead of failing if CLIENT_DIR is missing.
SERVE_CLIENT=true

# Path prefix to mount the whole app under. "/" serves at the root; "/garden"
# would serve the API at /garden/api/seeds and the client at /garden/.
#
# Leave this alone for Home Assistant ingress. Ingress strips its prefix before
# proxying, so the server sees plain "/" — and the per-session prefix the client
# needs arrives as the X-Ingress-Path header, which the server honours per
# request. BASE_PATH exists for a plain reverse proxy that does not strip.
BASE_PATH=/

# One log line per request.
LOG_REQUESTS=true

# "production" (the default) serves hashed assets with a one-year immutable
# cache header. Anything else revalidates, which is what you want while
# developing.
NODE_ENV=production

# ---------------------------------------------------------------------------
# Home Assistant
# ---------------------------------------------------------------------------
#
# Everything below is optional and none of it needs setting locally. The whole
# integration switches itself off unless SUPERVISOR_TOKEN is present, which it
# only ever is inside the add-on — so `npm run dev` on a laptop has no frost
# warnings, publishes no sensors and opens no sockets, rather than failing to
# reach a supervisor that is not there.
#
# In the add-on these are configured from the Home Assistant UI instead, via
# the add-on options, which take precedence over anything set here. These
# variables exist so the same code can be driven without a supervisor.

# Injected by Supervisor when the add-on declares homeassistant_api: true.
# Never set this by hand, and it must never reach the browser: every Home
# Assistant call is made server-side.
# SUPERVISOR_TOKEN=

# Where the Supervisor API lives. Only ever different in a test.
# SUPERVISOR_URL=http://supervisor

# The weather entity the forecast is read from. Must support forecasts; the
# add-on calls weather.get_forecasts rather than reading state attributes,
# because forecasts stopped being attributes in HA 2024.4.
# HA_WEATHER_ENTITY=weather.forecast_home

# Where a frost warning is sent. Any notify service works.
# HA_NOTIFY_SERVICE=notify.mobile_app_julie_s_phone

# Prefix for the four published sensors, e.g. sensor.garden_harvest_weight.
# Change it if those entity ids are already taken — the add-on refuses to
# overwrite an entity it did not create.
# HA_SENSOR_PREFIX=garden

# Set to false to keep the in-app frost banner and the sensors but stop the
# phone notifications.
# HA_FROST_NOTIFICATIONS=true

# No notifications during these hours, unless the frost is close enough that
# waiting until morning would be too late. 24-hour local time.
# HA_QUIET_HOURS_START=21:00
# HA_QUIET_HOURS_END=07:00

# Where the add-on options file is read from. The tests point this at a
# temporary directory so a real /data/options.json cannot leak into a test run.
# ADDON_OPTIONS_PATH=/data/options.json
